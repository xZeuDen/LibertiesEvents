<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Rating question -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="How would you rate this event?"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Star rating -->
    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1"
        android:rating="0"
        android:layout_marginBottom="24dp" />

    <!-- Recommendation question -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Would you recommend this event?"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Yes or No selection -->
    <RadioGroup
        android:id="@+id/radioRecommend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/radioYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yes" />

        <RadioButton
            android:id="@+id/radioNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No"
            android:layout_marginStart="20dp" />

    </RadioGroup>

    <!-- Optional written feedback -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Additional feedback (optional)"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tell us about your experience..."
        android:inputType="textMultiLine"
        android:gravity="top"
        android:minLines="3"
        android:maxLength="500" />

</LinearLayout>
